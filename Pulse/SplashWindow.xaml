<Window x:Class="Pulse.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse" Width="620" Height="450" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True">
  <Border x:Name="SplashCard" CornerRadius="20" BorderBrush="#3A315B" BorderThickness="1"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10101B" Offset="0"/>
        <GradientStop Color="#1A1530" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Ellipse Width="330" Height="330" Fill="#1D1840" Opacity="0.56" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-115,0"/>
      <Ellipse Width="190" Height="190" Fill="#302051" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-75,0,0,-95"/>
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="74" Height="74" CornerRadius="22" Background="#2A2148" BorderBrush="#8066C7" BorderThickness="1" HorizontalAlignment="Center">
          <TextBlock Text="P" Foreground="#C4B5FD" FontFamily="Segoe UI" FontSize="37" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="PULSE" Foreground="#F5F3FF" FontFamily="Segoe UI" FontWeight="Bold" FontSize="34" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="DIAGNOSTYKA WYDAJNOŚCI" Foreground="#AAA7BD" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <Border Height="1" Width="110" Background="#8066C7" HorizontalAlignment="Center" Margin="0,18,0,10"/>
        <TextBlock Text="BY ELOMEKSYKANIN" Foreground="#C4B5FD" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
        <Border Background="#332D2318" BorderBrush="#806B4B" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,12,0,0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="UWAGA  •  WERSJA BETA 0.1.2" Foreground="#FFD28A" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Aplikacja jest w fazie testów." Foreground="#D8C6A7" FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
        <Button x:Name="EnterButton" Content="Uruchom aplikację" Click="EnterApp" Margin="0,18,0,0" Padding="26,11"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="PANEL DIAGNOSTYCZNY DLA WINDOWS" Foreground="#7B7793" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
    </Grid>
  </Border>
</Window>
