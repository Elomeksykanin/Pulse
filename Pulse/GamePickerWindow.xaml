<Window x:Class="Pulse.GamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz grę" Width="650" Height="620" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style TargetType="ListBox" x:Key="PickerList">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Card" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="9" Padding="12">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#19313A"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#54708D"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="WYBÓR PROCESU" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
      <TextBlock Text="Którą grę monitorujemy?" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/>
      <TextBlock x:Name="CountLabel" Text="Wykryte aktywne okna" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,15"/>
    </StackPanel>
    <TextBox x:Name="SearchBox" Grid.Row="1" Height="40" VerticalContentAlignment="Center" Padding="12,8" Margin="0,0,0,12" TextChanged="SearchChanged"/>
    <ListBox x:Name="GameList" Grid.Row="2" Style="{StaticResource PickerList}" SelectionChanged="GameSelectionChanged" MouseDoubleClick="AcceptSelection">
      <ListBox.ItemTemplate><DataTemplate>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="9" Background="#20374A" VerticalAlignment="Center"><TextBlock Text="▣" Foreground="{StaticResource Accent}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Grid.Column="2" CornerRadius="10" Background="#1D2A3D" Padding="8,4" VerticalAlignment="Center">
            <TextBlock Text="{Binding ProcessLabel}" Foreground="{StaticResource Muted}" FontSize="9"/>
          </Border>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Tylko procesy z widocznym oknem są pokazywane." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Anuluj" Background="{StaticResource Card}" Foreground="{StaticResource Ink}" Click="CancelClick" Margin="0,0,8,0"/>
        <Button x:Name="SelectButton" Content="Monitoruj tę grę" IsEnabled="False" Click="AcceptClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
