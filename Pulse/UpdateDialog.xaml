<Window x:Class="Pulse.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizacja Pulse"
        Width="480" Height="290"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
        KeyDown="OnKeyDown">
  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
          BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentSoft}"
                BorderBrush="#493B74" BorderThickness="1">
          <TextBlock Text="↑" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Aktualizacja Pulse" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Nowa wersja jest gotowa do pobrania" Foreground="{StaticResource Muted}"
                     FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Content="✕" Width="32" Height="32" Padding="0"
                Background="Transparent" Foreground="{StaticResource Muted}"
                Click="OnLaterClick" ToolTip="Później"/>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}"
              BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,20,0,18">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DOSTĘPNA WERSJA" Foreground="{StaticResource Accent}"
                     FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="VersionText" Text="0.1.3" FontSize="21" FontWeight="SemiBold"
                     Margin="0,5,0,0"/>
          <TextBlock Text="Pulse pobierze aktualizację, a następnie uruchomi się ponownie."
                     Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                     Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Później" Background="{StaticResource Card}" Foreground="{StaticResource Ink}"
                Margin="0,0,9,0" Click="OnLaterClick"/>
        <Button Content="Pobierz i uruchom ponownie" Click="OnUpdateClick" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
