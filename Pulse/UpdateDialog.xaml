<Window x:Class="Pulse.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizacja Pulse"
        Width="500" Height="430" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="UpdateProgress" TargetType="ProgressBar">
      <Setter Property="Background" Value="#25263A"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" CornerRadius="3"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
          BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentSoft}"
                BorderBrush="#493B74" BorderThickness="1">
          <TextBlock Text="↑" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="DialogTitle" Text="Aktualizacja Pulse" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="DialogSubtitle" Text="Nowa wersja jest gotowa do pobrania" Foreground="{StaticResource Muted}"
                     FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="LaterButton" Grid.Column="2" Content="✕" Width="32" Height="32" Padding="0"
                Background="Transparent" Foreground="{StaticResource Muted}"
                Click="OnLaterClick" ToolTip="Później"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,18,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel>
            <TextBlock Text="DOSTĘPNA WERSJA" Foreground="{StaticResource Accent}"
                       FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Text="0.1.7" FontSize="21" FontWeight="SemiBold"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="LISTA ZMIAN" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
              <TextBlock x:Name="ReleaseNotesText" Text="Ulepszenia i poprawki." Foreground="{StaticResource Muted}"
                         FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" x:Name="DownloadProgressPanel" Visibility="Collapsed">
          <Grid Margin="0,0,0,6">
            <TextBlock x:Name="ProgressLabel" Text="Pobieranie aktualizacji…" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock x:Name="ProgressPercent" Text="0%" Foreground="{StaticResource Ink}" FontSize="10" HorizontalAlignment="Right"/>
          </Grid>
          <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource UpdateProgress}" Minimum="0" Maximum="100" Value="0" Height="6"/>
          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FF9DAB" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LaterActionButton" Content="Później" Background="{StaticResource Card}" Foreground="{StaticResource Ink}"
                Margin="0,0,9,0" Click="OnLaterClick"/>
        <Button x:Name="UpdateActionButton" Content="Pobierz i uruchom ponownie" Click="OnUpdateClick" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
