<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <Version>0.1.7</Version>
    <StartupObject>Pulse.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Content Include="Resources\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
