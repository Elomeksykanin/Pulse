<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse | diagnostyka PC" Height="820" Width="1240" MinHeight="700" MinWidth="1000"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MinimalProgressBar" TargetType="ProgressBar">
      <Setter Property="Background" Value="#25263A"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" CornerRadius="3"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavRoot" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NavMarker" Grid.Column="0" Width="3" Height="18" Background="{StaticResource Accent}" CornerRadius="2" Opacity="0.22" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Opacity" Value="0.9"/><Setter TargetName="NavMarker" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#191823" Offset="0"/><GradientStop Color="#14131E" Offset="1"/></LinearGradientBrush></Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.22" Color="#000000"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
      <Setter Property="Background" Value="#171622"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16"/>
      <Setter Property="BorderBrush" Value="#343147"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AAA7BD"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.Background><StaticResource ResourceKey="BackdropGradient"/></Grid.Background>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,25">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="◉  PULSE" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Bold" Margin="5,0,0,2"/>
          <TextBlock Text="PC HEALTH  /  WINDOWS" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="8,0,0,24"/>
          <Border Height="1" Background="{StaticResource Edge}" Margin="0,0,0,19"/>
          <TextBlock Text="DIAGNOSTYKA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="8,0,0,4"/>
          <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Content="▦  Przegląd sprzętu" Click="ShowOverview"/>
          <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" Content="◉  Analiza ogólna" Click="ShowGeneralAnalysis"/>
          <TextBlock Text="ANALIZA GRY" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="8,22,0,4"/>
          <Button x:Name="NavMonitor" Style="{StaticResource NavButton}" Content="◫  Pomiar i wyniki" Click="ShowMonitor"/>
          <TextBlock Text="KATEGORIE • WKRÓTCE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="8,22,0,4"/>
          <Button Style="{StaticResource NavButton}" Content="FPS i stabilność • Wkrótce" IsEnabled="False"/>
          <Button Style="{StaticResource NavButton}" Content="Bateria i energia • Wkrótce" IsEnabled="False"/>
          <Button Style="{StaticResource NavButton}" Content="Sieć i opóźnienia • Wkrótce" IsEnabled="False"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,0">
          <Border Height="1" Background="{StaticResource Edge}" Margin="0,0,0,15"/>
          <TextBlock Text="TRYB PRYWATNY" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
          <TextBlock Text="Dane są odczytywane lokalnie z komputera." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
          <TextBlock Text="Język / Language" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" Margin="0,14,0,5"/>
          <ComboBox x:Name="LanguageSelector" Height="32" SelectedValuePath="Tag" SelectionChanged="LanguageChanged">
            <ComboBoxItem Content="Polski" Tag="pl"/>
            <ComboBoxItem Content="English" Tag="en"/>
          </ComboBox>
          <Border Background="#151D33" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0" Padding="11,9">
            <Grid>
              <StackPanel>
                <TextBlock Text="Pulse" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="AppVersionText" Text="Wersja Beta 0.1.8" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
              </StackPanel>
              <Ellipse Width="7" Height="7" Fill="#4ADE80" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="Diagnostyka wydajności" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="Zbierz dane, zanim zdecydujesz o wymianie części." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
          <Button x:Name="UpdateButton" Content="Sprawdź aktualizacje" FontSize="10" Padding="12,7" Margin="0,0,10,0" Click="CheckForUpdates"/>
          <Border CornerRadius="20" Background="{StaticResource AccentSoft}" BorderBrush="#493B74" BorderThickness="1" Padding="12,7">
            <TextBlock x:Name="StatusText" Text="●  GOTOWY" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
          </Border>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid x:Name="OverviewPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Przegląd sprzętu" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Najważniejsze informacje o komputerze w jednym miejscu." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="ScanButton" Content="⟳   Skanuj komputer" HorizontalAlignment="Right" Click="ScanHardware"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="SYSTEM" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewSystemValue" Text="Kliknij „Skanuj komputer”, aby wykryć podzespoły." Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="PROCESOR" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewCpuValue" Text="—" Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="PAMIĘĆ RAM" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewRamValue" Text="—" Foreground="{StaticResource Ink}" FontSize="14" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="KARTY GRAFICZNE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewGpuValue" Text="—" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="DYSKI" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewDiskValue" Text="—" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <TextBlock Text="DOBRANIE CPU I GPU" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="OverviewCompatibilityValue" Text="Uruchom skan, aby oszacować dobranie procesora do karty graficznej." Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="JAK INTERPRETOWAĆ WYNIKI" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock x:Name="OverviewAdviceText" Text="Podzespoły same nie przesądzają o przyczynie spadków FPS. Zbierz pomiary podczas gry i sprawdź temperatury." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="GeneralAnalysisPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,12">
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="Analiza ogólna" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Obserwuj zasoby komputera podczas zwykłego użytkowania." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorder}" Background="#19172A" BorderBrush="#423761" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="CZAS OBSERWACJI" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Zbieranie danych odbywa się lokalnie i nie zamyka żadnych programów." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Czas (min)" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox x:Name="GeneralDurationBox" Grid.Column="1" Text="10" Height="38" VerticalContentAlignment="Center" ToolTip="Wpisz czas od 1 do 120 minut"/>
                  <Button x:Name="GeneralStartButton" Grid.Column="2" Content="▶  Rozpocznij analizę" Margin="10,0,0,0" Click="StartGeneralAnalysis"/>
                  <Button x:Name="GeneralStopButton" Grid.Column="3" Content="Zakończ i pokaż raport" HorizontalAlignment="Left" Margin="10,0,0,0"
                          Background="{StaticResource Card}" Foreground="{StaticResource Ink}" IsEnabled="False" Click="StopGeneralAnalysis"/>
                </Grid>
                <ProgressBar x:Name="GeneralProgress" Style="{StaticResource MinimalProgressBar}" Minimum="0" Maximum="1" Value="0" Height="5" Margin="0,16,0,9"/>
                <TextBlock x:Name="GeneralStatusText" Text="Gotowe do rozpoczęcia. Domyślny czas analizy to 10 minut." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <Grid>
                  <TextBlock Text="RAPORT ZASOBÓW" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyGeneralReportButton" Content="Kopiuj raport" FontSize="10" Padding="10,6" Margin="0,0,7,0"
                            Background="{StaticResource Card}" Foreground="{StaticResource Ink}" IsEnabled="False" Click="CopyGeneralReport"/>
                    <Button x:Name="ExportGeneralReportButton" Content="Zapisz jako TXT" FontSize="10" Padding="10,6"
                            Background="{StaticResource Card}" Foreground="{StaticResource Ink}" IsEnabled="False" Click="ExportGeneralReport"/>
                  </StackPanel>
                </Grid>
                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                  <StackPanel x:Name="GeneralReportContent">
                    <TextBlock Text="Po analizie pokażę średnie obciążenie CPU i RAM oraz procesy, które w czasie obserwacji zużywały najwięcej pamięci lub procesora."
                               Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,2"/>
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="MonitorPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="MonitorContent">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="SessionPanel" Grid.Row="0" Style="{StaticResource CardBorder}" Background="#19172A" BorderBrush="#423761" Margin="0,0,0,16">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <StackPanel>
                  <TextBlock Text="SESJA POMIAROWA" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Przygotuj analizę gry" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2D2548" BorderBrush="#4F3F7E" BorderThickness="1" CornerRadius="12" Padding="10,5">
                  <TextBlock Text="GOTOWE DO STARTU" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold"/>
                </Border>
              </Grid>
              <TextBlock Text="Uruchom grę, odtwórz spadek FPS i zostaw Pulse otwarte w tle." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,13"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,12,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Background="#20374A" VerticalAlignment="Center"><TextBlock Text="▣" Foreground="{StaticResource Accent}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="SelectedGameTitle" Text="Nie wybrano gry" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="SelectedGameDetails" Text="Wybierz aktywne okno gry, aby mierzyć użycie jej procesu." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Wybierz grę" Background="{StaticResource Card}" Foreground="{StaticResource Ink}" Click="ChooseGame"/>
                  <Button Content="↻" Width="42" Margin="7,0,0,0" Background="{StaticResource Card}" Foreground="{StaticResource Ink}" ToolTip="Odśwież listę okien" Click="RefreshGames"/>
                  <Button x:Name="MonitorButton" Content="▶  Rozpocznij" Margin="7,0,0,0" Click="ToggleMonitor"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="PING" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="PingHost" Grid.Column="1" Height="35" VerticalContentAlignment="Center" ToolTip="Adres IP lub nazwa serwera do testu ping"/>
                <Button Grid.Column="2" Content="Testuj host" Background="{StaticResource Card}" Foreground="{StaticResource Ink}" Margin="8,0,0,0" Click="TestPing"/>
                <TextBlock Grid.Column="3" Text="Adres serwera gry lub host do sprawdzenia" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
              <TextBlock Text="Pomiar FPS odczytuje zdarzenia klatek wybranej gry; Windows może poprosić o zgodę administratora. Temperatury zależą od dostępnych czujników." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="ResultsPanel" Grid.Row="1" Margin="0,0,0,16">
            <Grid Margin="3,0,3,9">
              <StackPanel><TextBlock Text="TELEMETRIA NA ŻYWO" Style="{StaticResource SectionLabel}"/><TextBlock Text="Najważniejsze wyniki sesji" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
              <TextBlock Text="ODŚWIEŻANIE CO 2 S" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <UniformGrid Columns="4">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8"><StackPanel><TextBlock Text="FPS ŚREDNIE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="FpsMetric" Text="—" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="FpsSubMetric" Text="czekam na grę" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8"><StackPanel><TextBlock Text="1% LOW" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="LowFpsMetric" Text="—" Foreground="#72A7FF" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="płynność najwolniejszych klatek" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8"><StackPanel><TextBlock Text="CPU • OBCIĄŻENIE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CpuSystemMetric" Text="System  —" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="GameCpuMetric" Text="Gra  —" Foreground="#72A7FF" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"><StackPanel><TextBlock Text="GPU • ZAJĘTOŚĆ KLATEK" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="GpuBusyMetric" Text="—" Foreground="#C39BFF" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="czas GPU w klatce gry" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU • TEMPERATURA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CpuTempMetric" Text="—" Foreground="#FFBD69" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="GPU • TEMPERATURA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="GpuTempMetric" Text="—" Foreground="#FFBD69" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="PAMIĘĆ RAM" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="RamMetric" Text="—" Foreground="#FFBD69" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="PING HOSTA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="PingMetric" Text="—" Foreground="#FF7185" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>
          </StackPanel>
          <Border x:Name="ChartPanel" Grid.Row="2" Style="{StaticResource CardBorder}" MinHeight="260">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <StackPanel>
                  <TextBlock Text="Obciążenie w czasie" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Ostatnie 60 pomiarów • około 2 minut" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,6,0"/>
                  <TextBlock Text="CPU systemu" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,14,0"/>
                  <Ellipse Width="8" Height="8" Fill="#48B8FF" Margin="0,0,6,0"/>
                  <TextBlock Text="RAM" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,14,0"/>
                  <Button x:Name="ChartExpandButton" Content="⛶  Powiększ" Padding="10,6" FontSize="10"
                          Background="{StaticResource Card}" Foreground="{StaticResource Ink}" Click="ToggleChartSize"/>
                </StackPanel>
              </Grid>
              <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,12,0,0" MinHeight="200" SizeChanged="ChartSizeChanged"/>
              </Grid>
          </Border>
          <Border x:Name="AwaitingResultsPanel" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Background="#171526" BorderBrush="#44386A">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <Border Width="66" Height="66" CornerRadius="20" Background="#2D2548" BorderBrush="#5D4A95" BorderThickness="1" HorizontalAlignment="Center">
                  <TextBlock Text="P" Foreground="#C4B5FD" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="AwaitingEyebrow" Text="GOTOWE DO ANALIZY" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock x:Name="AwaitingTitle" Text="Wyniki pojawią się po pomiarze" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center"/>
                <TextBlock x:Name="AwaitingSubtitle" Text="Wybierz grę, kliknij rozpocznij i graj chwilę. Po zakończeniu Pulse pokaże pełne podsumowanie." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,9,0,0"/>
              </StackPanel>
              <UniformGrid Grid.Row="1" Columns="3" Margin="4,0,4,0">
                <StackPanel><TextBlock Text="01" Foreground="#A78BFA" FontSize="17" FontWeight="Bold"/><TextBlock Text="Wybierz grę" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Wskaż okno gry." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="02" Foreground="#A78BFA" FontSize="17" FontWeight="Bold"/><TextBlock Text="Zbierz dane" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Odtwórz problem z FPS." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="03" Foreground="#A78BFA" FontSize="17" FontWeight="Bold"/><TextBlock Text="Sprawdź wynik" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Oceń raport sesji." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
              </UniformGrid>
            </Grid>
          </Border>
          <Border Grid.Row="3" x:Name="SummaryPanel" Style="{StaticResource CardBorder}" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel><TextBlock x:Name="SummaryHeading" Text="PODSUMOWANIE SESJI" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
              <TextBlock x:Name="SummaryText" Text="" Foreground="{StaticResource Ink}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
